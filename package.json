{
  "name": "electribe-sample-werkstatt",
  "version": "1.0.0-beta.1",
  "description": "Sample manager for Korg Electribe ESX-1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "author": "ESX Manager",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chokidar": "^5.0.0",
    "electribe": "^0.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.electribe-sample-werkstatt.app",
    "productName": "Electribe Sample Werkstatt",
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!analyze-esx.js",
      "!compare-fixes.js",
      "!test-esx-fix.js",
      "!test-data/**/*",
      "!tests/**/*",
      "!coverage/**/*",
      "!vitest.config.js",
      "!TESTING.md",
      "!EMX_SMARTCARD_FORMAT.md",
      "!korg-esx-file-structur",
      "!CLAUDE.md"
    ]
  }
}
